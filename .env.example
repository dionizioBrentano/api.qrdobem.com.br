APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- QR do Bem ---
# URL pública gravada dentro do QR Code. Cada frontend whitelabel pode ter a sua.
QR_PUBLIC_BASE_URL=https://qrdobem.com.br
QR_PUBLIC_PATH_PREFIX=q
# Lado do QR em pixels (SVG é vetorial; isso define o viewBox)
QR_SIZE=512
# Quiet zone em módulos. Abaixo de 4 alguns leitores falham.
QR_MARGIN=4
# Correção de erro: L(7%) M(15%) Q(25%) H(30%). Q suporta desgaste da etiqueta.
QR_ERROR_CORRECTION=Q
QR_ONBOARDING_DAYS=30

# =====================================================================
# MERCADO PAGO
# ---------------------------------------------------------------------
# REGRA DE OURO: Public Key e Access Token do MESMO par (TEST ou PROD)
# precisam vir da MESMA aba do painel. Misturar os dois ambientes causa
# o erro 401 "Unauthorized use of live credentials" (code 7).
#
# Onde pegar: mercadopago.com.br/developers/panel/app
#   -> selecione a aplicação -> menu "Credenciais de produção"
#                            ou menu "Credenciais de teste"
# =====================================================================

# Define qual PAR de credenciais o backend usa: "test" ou "prod".
# test -> usa os _TEST abaixo | prod -> usa os _PROD abaixo
MERCADOPAGO_MODE=test

# --- PAR DE TESTE (aba "Credenciais de teste") ---
# Só funciona com cartões de teste e usuário de teste. Não cobra de verdade.
MERCADOPAGO_PUBLIC_KEY_TEST=
MERCADOPAGO_ACCESS_TOKEN_TEST=

# --- PAR DE PRODUÇÃO (aba "Credenciais de produção") ---
# Cobra de verdade, com cartão real.
MERCADOPAGO_PUBLIC_KEY_PROD=
MERCADOPAGO_ACCESS_TOKEN_PROD=

# --- WEBHOOK ---
# Gerado no painel em "Webhooks > Configurar notificações" ao clicar em Salvar.
# URL a cadastrar lá: https://api.qrdobem.com.br/api/webhooks/mercadopago
# Evento a marcar: "Pagamentos" (topic: payment)
MERCADOPAGO_WEBHOOK_SECRET=

# =====================================================================
# CRÉDITOS / CHECKOUT
# =====================================================================
# Usada nas URLs de retorno do pagamento.
FRONTEND_URL=https://qrdobem.com.br
# Preço por crédito em BRL. Só vale se a tabela credit_pricing estiver vazia.
CREDITS_UNIT_PRICE=1.00
CREDITS_MIN_QTY=1
CREDITS_MAX_QTY=500

# =====================================================================
# DOAÇÕES
# =====================================================================
# Taxa operacional da OSCIP/plataforma sobre o VALOR BRUTO da doação (%).
# Única modalidade fiscal ativa: doação com recibo da OSCIP gestora — não há
# incentivo homologado, então não existe dedução de IRPF. O custo do meio de
# pagamento é separado e discriminado por doação, não sai desta variável.
DONATION_PLATFORM_FEE_PERCENT=12
